{
  "name": "policydesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:clean-demo": "tsx scripts/clean-demo-data.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && tsx scripts/ui-usage.ts --check && npm test",
    "test": "vitest run",
    "ui:usage": "tsx scripts/ui-usage.ts",
    "test:e2e": "rm -rf .pglite-e2e && PGLITE_DIR=./.pglite-e2e tsx scripts/setup-db.ts && playwright test",
    "test:e2e:ui": "rm -rf .pglite-e2e && PGLITE_DIR=./.pglite-e2e tsx scripts/setup-db.ts && playwright test --ui"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hookform/resolvers": "^5.2.1",
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "marked": "^15.0.12",
    "mermaid": "^11.4.1",
    "next": "15.5.29",
    "next-intl": "4.14.10",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "^7.62.0",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
